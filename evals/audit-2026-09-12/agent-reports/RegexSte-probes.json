  "probes": {
    "passive_often": {
      "input": "The option is often useful.",
      "rule": "ste-verbs.passive-voice",
      "findings": 1,
      "verdict": "false positive: suffix (en) treats adverb often as participle"
    },
    "passive_adjectival": {
      "input": "The option is enabled.",
      "rule": "ste-verbs.passive-voice",
      "findings": 1,
      "verdict": "ambiguous adjectival predicate; candidate FP"
    },
    "passive_active_control": {
      "input": "The controller enables the option.",
      "rule": "ste-verbs.passive-voice",
      "findings": 0,
      "verdict": "control"
    },
    "aux_adjectival": {
      "input": "The service can be enabled by setting the flag.",
      "rule": "ste-verbs.auxiliary-stacking",
      "findings": 1,
      "verdict": "duplicate with passive; valid capability statement"
    },
    "aux_active_control": {
      "input": "You can enable the service by setting the flag.",
      "rule": "ste-verbs.auxiliary-stacking",
      "findings": 0,
      "verdict": "control"
    },
    "colon_non_list": {
      "input": "The gateway sends the request through the authenticated proxy before it applies the retry policy for all clients in production environments today: the parser reads this value.",
      "rule": "ste-punctuation.colon-terminates-sentence-for-count",
      "findings": 1,
      "verdict": "false positive: colon not followed by a vertical list"
    },
    "colon_list_control": {
      "input": "The gateway sends these values:\n- The host\n- The port",
      "rule": "ste-punctuation.colon-terminates-sentence-for-count",
      "findings": 0,
      "verdict": "control"
    },
    "paren_boundary": {
      "input": "(1) The gateway reads request metadata and validates token before sending request to service for processing and records result in audit log for later review today.",
      "rule": "ste-descriptive.sentence-too-long-descriptive",
      "engine_words": 26,
      "spec_words": 25,
      "findings": 1,
      "verdict": "false positive: parenthesized step number counted as one, not stripped per 8.6"
    },
    "inline_code_control": {
      "input": "Use the `very-long-identifier-name` option before you restart the worker and inspect the logs after the migration completes.",
      "engine_words": 17,
      "findings": 0,
      "verdict": "code span counted once"
    },
    "plain_url_control": {
      "input": "Use the https://example.com/api/v1/really-long-path endpoint before you restart the worker and inspect the logs after the migration completes.",
      "engine_words": 17,
      "findings": 0,
      "verdict": "plain URL treated as one prose token by parser"
    },
    "table_control": {
      "input": "| one | two | three | four | five |\n| --- | --- | --- | --- | --- |\n| Use | the | worker | before | restart |",
      "engine_words": 10,
      "findings": 0,
      "verdict": "table cells separated"
    },
