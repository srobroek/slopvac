docs-discipline.HistoryNarration = NO
docs-discipline.InternalRefs = NO
prose-inflation.SlopLexicon = NO
prose-inflation.BusinessJargon = NO
prose-inflation.VagueDeclarative = NO
prose-inflation.AdditiveHedge = NO
prose-inflation.VagueQuantifier = NO
prose-inflation.Intensifier = NO
prose-inflation.Apologizing = NO
prose-inflation.HedgeStack = NO
prose-inflation.Uncomparables = NO
prose-agency.FalseAgency = NO
prose-agency.AgentlessPassive = NO
prose-agency.NarratorDistance = NO
prose-inclusive.Exclusive = NO
prose-inclusive.Ableist = NO
prose-inclusive.DeviceAssumption = NO
prose-craft.Annotations = NO
prose-craft.Redundancy = NO
prose-craft.Latinisms = NO
prose-craft.DirectionalRef = NO
prose-scope.RejectedAlternative = NO
prose-scope.ImplementationLeak = NO
prose-scope.UnrequestedReassurance = NO
prose-scope.Epigram = NO
ai-residue.ChatLeakage = NO
ai-tells.ContrastiveNegation = NO

# --- Generated by other tools ------------------------------------------------
# `bd init` writes and rewrites these on every upgrade, so a fix here is undone
# by the next `bd` release. Exclude them rather than editing a file this project
# does not own.
[**/{AGENTS,CLAUDE,GEMINI}.md]
BasedOnStyles =

[**/.beads/**]
BasedOnStyles =

[**/.agents/**]
BasedOnStyles =
