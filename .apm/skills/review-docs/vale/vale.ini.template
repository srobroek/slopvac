# Prose gate for this project. Scaffolded by the review-docs skill; yours to edit.
#
# Vale reads ONE config file, with no include or extends directive, so this file
# is the whole configuration rather than a patch over a packaged default. Commit
# it. `scripts/init-vale.sh` will not overwrite it.
#
# Update the rules with `vale --config=.vale.ini sync`: every URL below points at
# a rolling release tag whose assets are replaced on each publish.
#
# Three syntax traps, all silent when wrong:
#   - `|` alternation in a section header matches NOTHING. Use `{a,b}`.
#   - `Style.* = <level>` does not demote a whole style; each rule needs a line.
#   - An extension with no Vale parser and no `[formats]` alias lints as NOTHING
#     and exits 0. Any extension you add needs a fixture proving it fires.

StylesPath = .vale-styles
MinAlertLevel = warning

Packages = https://github.com/tbhb/vale-ai-tells/releases/latest/download/ai-tells.zip, \
  https://github.com/srobroek/slopvac/releases/download/vale-styles/ai-residue.zip, \
  https://github.com/srobroek/slopvac/releases/download/vale-styles/prose-agency.zip, \
  https://github.com/srobroek/slopvac/releases/download/vale-styles/prose-inflation.zip, \
  https://github.com/srobroek/slopvac/releases/download/vale-styles/prose-scope.zip, \
  https://github.com/srobroek/slopvac/releases/download/vale-styles/docs-discipline.zip, \
  https://github.com/srobroek/slopvac/releases/download/vale-styles/prose-format.zip, \
  https://github.com/srobroek/slopvac/releases/download/vale-styles/prose-craft.zip, \
  https://github.com/srobroek/slopvac/releases/download/vale-styles/prose-inclusive.zip, \
  https://github.com/srobroek/slopvac/releases/download/vale-styles/prose-density.zip

# `.mdx` is aliased for COVERAGE, not because no parser exists. Vale can parse MDX
# natively by shelling out to `mdx2vast` (npm), but native parsing skips JSX
# children -- and in a component-driven docs site most prose lives inside
# `<Callout>` and `<Note>`. Measured on a fixture: native found 1 finding where
# the alias found 5. Native also aborts the whole run with exit 1 when the binary
# is absent, and again on `# Heading {#anchor}` ("Could not parse expression with
# acorn"). The alias costs false positives on `export const` string values and JSX
# attributes; that trade is the cheaper one.
#
# Do NOT alias tsx/jsx -- `tsx = html` errors and `tsx = md` reports zero findings
# silently. JSX text is extracted by the skill's scripts/extract-prose.sh.
[formats]
mdx = md

[*.{md,mdx}]
BasedOnStyles = ai-residue, prose-agency, prose-inflation, prose-scope, docs-discipline, prose-format, prose-craft, prose-inclusive, prose-density, ai-tells

# Duplicate coverage: Vale's built-in repetition check ("the the") is free and
# needs no package.
Vale.Repetition = error

# MDX anchor syntax (`# Heading {#slug}`) is markup, not prose. Lifted from the
# upstream `MDX` config package, which is these two lines and nothing else.
TokenIgnores = '({#[^\n}]+})(?!`)'

# --- Upstream ai-tells rules that are wrong for a software repo ---------------
# ai-tells ships 75 of its 76 rules at error. These are measured exclusions, not
# taste: re-enable one only after checking it against your own corpus.

# A retired 2023-24 marker-word band, plus words with ordinary technical uses
# (comprehensive, granular, scalable). prose-inflation.SlopLexicon is the
# maintained ban list.
ai-tells.OverusedVocabulary = NO
ai-tells.AICompoundPhrases = warning

# Flags implement / implementation / framework. Correct words in this domain.
ai-tells.FormalRegister = NO

# Over-fitted to one idiom, and to startup-as-organism metaphors.
ai-tells.RedundantPrecaution = NO
ai-tells.GrowthMetaphors = NO

# Its token list includes the literal `--`. Use prose-format.NoUnicodeDash, which
# bans only real U+2014/U+2013 and reaches inside code.
ai-tells.EmDashUsage = NO

# Ordinary English connectives at error: specifically, likewise, therefore.
ai-tells.FormalTransitions = NO

# Punctuation-frequency opinions, not AI tells. A semicolon joining two clauses
# and a colon before a proper noun are correct.
ai-tells.SemicolonUsage = NO
ai-tells.ColonUsage = NO

# Cannot tell a rhetorical tricolon from a three-item technical enumeration
# ("create, update, and delete"). Worth seeing, not gating on.
ai-tells.VerbTricolon = warning

# "ship" is domain vocabulary in software, not a tell.
ai-tells.ShipOveruse = NO

# Their own rule comments concede these are over-broad.
ai-tells.MicDrop = warning
ai-tells.ParallelStaccato = warning

# --- Markup surfaces ---------------------------------------------------------
# Vale parses these natively. json/yaml catch i18n locale files, where shipped
# UI copy lives. `.rst` and `.adoc` are absent on purpose: both need an external
# converter (rst2html, asciidoctor) and abort the whole run without it.
[*.{html,json,yaml,yml}]
BasedOnStyles = ai-residue, prose-agency, prose-inflation, prose-scope, docs-discipline, prose-format, prose-craft, prose-inclusive, ai-tells

# A locale file has no sentences to average, so the metric divides by near-zero
# and every file scores as unreadable. Headings and acronym-definition rules need
# document structure these formats do not carry.
prose-craft.SentenceLength = NO
prose-craft.GerundHeading = NO
prose-craft.UndefinedAcronym = NO
prose-craft.SelfReference = NO

# --- Source files: comments and docstrings -----------------------------------
# Vale is syntax-aware here with no alias and no extractor: it lints comments and
# docstrings and skips identifiers and string literals, so a field named `robust`
# stays clean while the doc comment above it does not.
#
# An allowlist, not the full set. Measured on 55 files: the full set produced 214
# findings, almost all false, because code-comment register is terse and
# legitimately negative ("No PCRE, no \b" trips ContrastiveNegation). The list
# below produced 8. Every rule here matches a defect in any register.
[*.{go,rs,py,ts,js,mjs,cjs,tsx,jsx,java,rb,c,h,cpp,cs,swift,kt,php,sh,bash,lua}]
BasedOnStyles =
prose-inflation.SlopLexicon = error
prose-inflation.BusinessJargon = error
prose-inflation.VagueDeclarative = error
prose-inflation.AdditiveHedge = error
prose-agency.FalseAgency = error
prose-agency.AgentlessPassive = error
prose-agency.Anthropomorphism = error
prose-format.NoUnicodeDash = error
ai-residue.ChatLeakage = error
docs-discipline.StatusLanguage = error
ai-tells.AffirmativeFormulas = error
ai-tells.Metacommentary = error
ai-tells.UrgencyInflation = error
ai-tells.VagueAttributions = error
prose-craft.ConflictMarkers = error
prose-craft.Redundancy = error
prose-inflation.Uncomparables = error
prose-inflation.Intensifier = error
prose-inflation.HedgeStack = error
prose-inclusive.Exclusive = error
prose-inclusive.Ableist = error

# --- Genre routing -----------------------------------------------------------
# A decision record exists to hold a decision and the measurement behind it, so
# the rules that ban that content elsewhere invert here. Internal references are
# what these documents are for.
# Four craft rules invert for internal docs, for reasons specific to the genre:
#   FirstPersonPlural  an ADR records what WE decided; that is the document's job
#   NegativeRequirement a spec states constraints as prohibitions on purpose
#   SelfReference      a long spec legitimately cross-references its own sections
#   UndefinedAcronym   the audience is the team that owns the vocabulary
[**/{specs,.specify,docs/adr,docs/decisions}/**/*.md]
docs-discipline.InternalRefs = NO
prose-scope.RejectedAlternative = NO
prose-scope.ImplementationLeak = NO
prose-craft.FirstPersonPlural = NO
prose-craft.NegativeRequirement = NO
prose-craft.SelfReference = NO
prose-craft.UndefinedAcronym = NO

[**/{adr,ADR,rfc,RFC}/**/*.md]
docs-discipline.InternalRefs = NO
prose-scope.RejectedAlternative = NO
prose-scope.ImplementationLeak = NO
prose-craft.FirstPersonPlural = NO
prose-craft.NegativeRequirement = NO
prose-craft.SelfReference = NO
prose-craft.UndefinedAcronym = NO

[**/{CONTRIBUTING,constitution,ARCHITECTURE,DESIGN}*.md]
docs-discipline.InternalRefs = NO
prose-scope.RejectedAlternative = NO
prose-scope.ImplementationLeak = NO
prose-craft.FirstPersonPlural = NO
prose-craft.NegativeRequirement = NO
prose-craft.SelfReference = NO
prose-craft.UndefinedAcronym = NO

# A reference table has no sentences, so the reading-ease formula divides by
# near-zero and scores a correct table as unreadable prose. Measured: two
# table-heavy files here scored 10.6 and -36.8.
[**/references/**/*.md]
prose-density.Overwritten = NO

# --- Project overrides -------------------------------------------------------
# A rule line belongs to the section ABOVE it, so put an override directly under
# the `[...]` header it should apply to -- normally `[*.{md,mdx}]` near the top of
# this file. A line appended at the end of the file silently binds to the last
# section instead, and the rule keeps firing everywhere else.
#
# Under `[*.{md,mdx}]`, with a reason, because the next reader needs to know
# whether it still holds:
#
#   prose-scope.ImplementationLeak = NO   # latency is the product; we publish it
#   prose-format.NoUnicodeDash = NO       # house style uses real em dashes
#   prose-inflation.BusinessJargon = warning
#
# Turn a rule OFF entirely       rule = NO
# Demote it to advisory          rule = warning
# Turn a whole style off         drop it from that section's BasedOnStyles list
# Exempt one path                [**/generated/**] then BasedOnStyles =
# Exempt one passage             <!-- vale prose-scope.ImplementationLeak = NO -->
#                                ...text...
#                                <!-- vale prose-scope.ImplementationLeak = YES -->
#                                (the comment must be on its own line)

# The rule reference in vale-styles/README.md is GENERATED from the rule files, and
# each rule's summary quotes the pattern it bans -- so the table trips the rules it
# documents. Same reason the ai-tells catalogue files are excluded: this is
# normative source for the gate, not prose the gate should judge.
[**/vale-styles/README.md]
BasedOnStyles =

